
# Environment Variables
PORT=3000

# Database Configuration (sqlite | postgres)
DB_TYPE=sqlite
# If postgres:
DB_HOST=localhost
DB_PORT=5432
DB_USER=ymh_user
DB_PASS=ymh_password
DB_NAME=ymh_db

# Storage Configuration (local | gcs)
STORAGE_TYPE=local
# If gcs:
GCP_PROJECT_ID=ymh-project-id
GCP_BUCKET_NAME=ymh-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=./path-to-your-service-account-key.json
